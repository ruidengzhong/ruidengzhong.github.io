---
layout: default
---
<div class="post about-page home-page">
  <header class="home-hero" aria-labelledby="home-name">
    <div class="home-blocks" aria-hidden="true"><div class="home-block-track"></div></div>
    <div class="home-hero-inner">
      {% if page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% assign profile_alt = site.first_name | append: ' ' | append: site.last_name %}
        <div class="home-portrait">
          {% include figure.liquid loading="eager" path=profile_image_path class="home-portrait-image" sizes="(min-width: 900px) 420px, (min-width: 600px) 50vw, 85vw" alt=profile_alt cache_bust=true %}
        </div>
      {% endif %}
      <div class="home-introduction">
        <p class="home-eyebrow">{{ page.hero_affiliation | escape }}</p>
        <h1 id="home-name">
          {{ site.first_name -}}
          <br>
          {{ site.last_name }}
        </h1>
        <p class="home-tagline">{{ page.hero_tagline | escape }}</p>
        <nav class="home-actions" aria-label="Explore my work">
          <a class="home-action home-action-primary" href="{{ '/projects/' | relative_url }}">Projects <span aria-hidden="true">↗</span></a>
          <a class="home-action" href="{{ '/experience/' | relative_url }}">Work experience <span aria-hidden="true">↗</span></a>
          <a class="home-action" href="mailto:{{ site.data.socials.email }}">Contact <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </div>
    <a class="home-scroll" href="#student-engineer">The person behind the projects <span aria-hidden="true">↓</span></a>
  </header>

  <article class="home-story-content">
    {{ content }}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
