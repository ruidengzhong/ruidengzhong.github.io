---
layout: default
---
{% if page.collection == 'experiences' %}
  {% assign section_title = 'Work Experience' %}
  {% assign section_url = '/experience/' %}
{% else %}
  {% assign section_title = 'Projects' %}
  {% assign section_url = '/projects/' %}
{% endif %}
<article class="portfolio-detail{% if page.collection == 'experiences' %} experience-detail{% endif %}">
  <a class="section-back" href="{{ section_url | relative_url }}">&larr; {{ section_title }}</a>
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.company %}
      <p class="detail-company">{{ page.company }}</p>
    {% endif %}
    <div class="detail-meta">
      {% if page.collection == 'experiences' and page.location %}
        <span>{{ page.location }}</span>
      {% endif %}
      {% if page.start_date -%}
        <span>{{ page.start_date }} &ndash; {{ page.end_date | default: 'Present' }}</span>
      {%- endif %}
      {% if page.collection != 'experiences' and page.location -%}
        <span>{{ page.location }}</span>
      {%- endif %}
      {% if page.status -%}
        <span class="status-label">{{ page.status }}</span>
      {%- endif %}
    </div>
    {% if page.tools %}
      <ul class="skill-tags" aria-label="Tools and skills">
        {% for tool in page.tools %}
          <li>{{ tool | escape }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>
  {% if page.outcome %}
    <section class="outcome-panel" aria-label="{% if page.status == 'In progress' %}Current focus{% else %}Key outcome{% endif %}">
      <h2>
        {% if page.status == 'In progress' %}Current focus{% else %}Key outcome{% endif %}
      </h2>
      <p>{{ page.outcome | escape }}</p>
    </section>
  {% endif %}
  {% if page.contributions %}
    <section class="contribution-section">
      <h2>My contribution</h2>
      <ul>
        {% for contribution in page.contributions %}
          <li>{{ contribution | escape }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
  <div class="detail-content">{{ content }}</div>
  {% if page.image %}
    <div class="experience-image">
      {% assign image_alt = page.image_alt | default: page.company %}
      {% include figure.liquid path=page.image alt=image_alt class="img-fluid rounded" %}
      {% if page.image_credit %}
        <p class="caption">
          Photo: <a href="{{ page.image_credit_url }}">{{ page.image_credit }}</a>
        </p>
      {% endif %}
    </div>
  {% endif %}
</article>
