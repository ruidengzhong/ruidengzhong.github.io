<div class="col">
  <div class="card h-100 hoverable">
    {% if project.img %}
      {%
        include figure.liquid
        loading="lazy"
        path=project.img
        sizes = "250px"
        alt=project.title
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      {% if project.status %}
        <p class="status-label">{{ project.status }}</p>
      {% endif %}
      <h2 class="card-title">
        <a
          class="stretched-link project-link"
          href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
        >
          {{- project.title | escape -}}
        </a>
      </h2>
      <p class="card-text">{{ project.description }}</p>
      <div class="row ml-1 mr-1 p-0">
        {% if project.github %}
          <div class="github-icon">
            <div class="icon" data-toggle="tooltip" title="Code Repository">
              <a class="project-repository-link" href="{{ project.github }}" aria-label="Code repository for {{ project.title | escape }}"
                ><i class="fa-brands fa-github gh-icon" aria-hidden="true"></i
              ></a>
            </div>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
